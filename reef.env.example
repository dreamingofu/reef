# Copy to reef.env and fill in. Lines are KEY=VALUE; quotes optional.
REEF_PORT=5274
# Folder Navidrome scans. Downloads go into a "Reef" subfolder of it.
REEF_MUSIC_DIR=/data/data/com.termux/files/home/storage/shared/Music
REEF_NAVIDROME_URL=http://127.0.0.1:4533
# Navidrome admin account, used only to trigger a rescan after each download.
REEF_NAVIDROME_USER=
REEF_NAVIDROME_PASS=
# Who can open Reef: loopback and Tailscale (100.64.0.0/10, fd7a:115c:a1e0::/48) always, with no password.
# Any other network (home Wi-Fi, LAN) needs this password (HTTP Basic, any user name); empty = they get a 403.
REEF_PASSWORD=
# 1 = treat every network alike, as before 2026-10-22: open to all, or REEF_PASSWORD for all when set. Leave 0.
# Note: `tailscale serve`/`funnel` reach Reef from 127.0.0.1, so Funnel (public internet) would count as trusted.
REEF_OPEN=0
# 1 = Flask's development server instead of waitress (local debugging only).
REEF_DEV=0
# Rotated log (reef.log, 1 MB x 5). Default: logs/ in the Reef folder.
REEF_LOG_DIR=
# Optional: yt-dlp YouTube player client(s) for stream resolution, comma-separated
# (e.g. ios,web_safari). Empty = yt-dlp default. Compare with:
#   python scripts/bench_resolve.py dQw4w9WgXcQ
REEF_YT_CLIENT=
# Optional: search source used by default: yt (YouTube), mc (Monochrome), nd (Navidrome library).
REEF_DEFAULT_SOURCE=yt
# Monochrome tracks API instance(s) for lossless search/stream, comma-separated. Empty = off.
REEF_TRACKS_API=https://tracks.monochrome.st
# Optional: Piped / Invidious API instance(s), comma-separated, used only as fallbacks when yt-dlp
# fails to search or resolve a YouTube track. Instances must allow API access. Empty = off.
REEF_PIPED_INSTANCES=
REEF_INVIDIOUS_INSTANCES=
# Search through YouTube Music (songs with artist/album and square art), with search suggestions and
# song radio. Anonymous, no account. 0 = plain yt-dlp YouTube search, no suggestions or radio.
REEF_YTMUSIC=1
# Optional: cut SponsorBlock segments (non-music, sponsor, intro, outro) from kept YouTube tracks.
# 1 = on. If the SponsorBlock API is unreachable the track is kept uncut.
REEF_SPONSORBLOCK=0
# Optional: before keeping a YouTube track, look for the same recording on Monochrome (REEF_TRACKS_API) and keep
# it as FLAC instead; falls back to the YouTube keep when there's no confident match. 1 = on (also in Settings).
# Note: Monochrome is a third-party Tidal proxy, legally grey and only as reliable as it is.
REEF_KEEP_LOSSLESS=0
# Kept tracks get lyrics from LRCLIB (lrclib.net) embedded in their tags, synced (LRC) when available.
# Lookups are cached here; default: lyrics.json next to the history file.
REEF_LYRICS_FILE=
# Blocked artists (hidden from search, radio, playlists, album pages). Default: blocklist.json next to the
# history file.
REEF_BLOCKLIST_FILE=
# Listen log (plays reported by the player, for stats / recap), liked tracks, local playlists and the
# settings changed from the UI (they override the values in this file). Default: next to the history file.
REEF_LISTENS_FILE=
REEF_LIKES_FILE=
REEF_PLAYLISTS_FILE=
REEF_SETTINGS_FILE=
# ListenBrainz scrobble queue, the cached update check and the backups folder (daily snapshots, kept 7, and a
# copy taken before every restore). Default: next to the history file.
REEF_SCROBBLES_FILE=
REEF_UPDATE_FILE=
REEF_BACKUP_DIR=
# What songs matched by title/artist (queue placeholders, imports) resolved to, incl. manual "Wrong song?" fixes.
# Default: matches.json next to the history file.
REEF_MATCHES_FILE=
# The status sheet's "Update" (git pull + restart, or pip install -U yt-dlp + restart) runs on Termux only.
# 1 = allow it on another host too (it pulls this checkout and restarts through termux/reef-boot.sh). Leave 0.
REEF_ALLOW_SELF_UPDATE=0
# YouTube Music moods & genres cache (refetched weekly). Default: browse.json in the Reef folder.
REEF_BROWSE_FILE=
# Optional: also write synced lyrics as a .lrc file next to each kept track. 1 = on.
REEF_LRC_SIDECAR=0
# Measure each kept track's loudness and write ReplayGain (and Opus R128) gain tags, so Navidrome
# clients play kept tracks at an even volume. 1 = on. Adds a few seconds of ffmpeg per keep.
REEF_REPLAYGAIN=1
# Optional, power users: extra yt-dlp options for keeps, as one JSON object on one line, e.g.
#   REEF_YDL_EXTRA={"cookiefile": "/data/data/com.termux/files/home/cookies.txt", "ratelimit": 2000000}
# It can't override postprocessors, progress_hooks, paths or outtmpl. Invalid JSON is ignored.
REEF_YDL_EXTRA=
# Test only: the stream proxy answers 403 for Range requests past ~60 s of a track's first stream URL,
# like YouTube walling a client mid-song, so the player's recovery can be tried. 1 = on. Leave 0.
REEF_FAKE_WALL=0

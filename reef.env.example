# Copy to reef.env and fill in. Lines are KEY=VALUE; quotes optional.
REEF_PORT=5274
# Folder Navidrome scans. Downloads go into a "Reef" subfolder of it.
REEF_MUSIC_DIR=/data/data/com.termux/files/home/storage/shared/Music
REEF_NAVIDROME_URL=http://127.0.0.1:4533
# Navidrome admin account, used only to trigger a rescan after each download.
REEF_NAVIDROME_USER=
REEF_NAVIDROME_PASS=
# Optional: require this password to open Reef (HTTP Basic). Empty = no password.
REEF_PASSWORD=
# Optional: yt-dlp YouTube player client(s) for stream resolution, comma-separated
# (e.g. ios,web_safari). Empty = yt-dlp default. Compare with:
#   python scripts/bench_resolve.py dQw4w9WgXcQ
REEF_YT_CLIENT=
# Optional: search source used by default: yt (YouTube), mc (Monochrome), nd (Navidrome library).
REEF_DEFAULT_SOURCE=yt
# Monochrome tracks API instance(s) for lossless search/stream, comma-separated. Empty = off.
REEF_TRACKS_API=https://tracks.monochrome.st
# Optional: Piped / Invidious API instance(s), comma-separated, used only as fallbacks when yt-dlp
# fails to search or resolve a YouTube track. Instances must allow API access. Empty = off.
REEF_PIPED_INSTANCES=
REEF_INVIDIOUS_INSTANCES=
# Search through YouTube Music (songs with artist/album and square art), with search suggestions and
# song radio. Anonymous, no account. 0 = plain yt-dlp YouTube search, no suggestions or radio.
REEF_YTMUSIC=1
# Optional: cut SponsorBlock segments (non-music, sponsor, intro, outro) from kept YouTube tracks.
# 1 = on. If the SponsorBlock API is unreachable the track is kept uncut.
REEF_SPONSORBLOCK=0
# Kept tracks get lyrics from LRCLIB (lrclib.net) embedded in their tags, synced (LRC) when available.
# Lookups are cached here; default: lyrics.json next to the history file.
REEF_LYRICS_FILE=
# Optional: also write synced lyrics as a .lrc file next to each kept track. 1 = on.
REEF_LRC_SIDECAR=0
# Measure each kept track's loudness and write ReplayGain (and Opus R128) gain tags, so Navidrome
# clients play kept tracks at an even volume. 1 = on. Adds a few seconds of ffmpeg per keep.
REEF_REPLAYGAIN=1
# Optional, power users: extra yt-dlp options for keeps, as one JSON object on one line, e.g.
#   REEF_YDL_EXTRA={"cookiefile": "/data/data/com.termux/files/home/cookies.txt", "ratelimit": 2000000}
# It can't override postprocessors, progress_hooks, paths or outtmpl. Invalid JSON is ignored.
REEF_YDL_EXTRA=
